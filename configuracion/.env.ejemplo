# copiar este archivo como ".env" en la RAÍZ del proyecto y completar los valores.
# el .env real nunca se sube al repositorio (está en .gitignore).

# --- servidor backend ---
PUERTO=4000

# dirección pública de la interfaz: arma el enlace de recuperar clave y el del
# checkout de la pasarela Demo. en el servidor va la del dominio. también se
# edita desde Configuración ("Dirección web").
APP_URL=http://localhost:5173

# nombre genérico que se ve en el ingreso y en la configuración inicial, cuando
# todavía no se sabe de qué institución es quien entra
PLATAFORMA_NOMBRE=Sistema de Información Gerencial

# 1 cuando el sistema corre detrás de un proxy (nginx, cloudflare): sin esto
# la auditoría anota la ip del proxy y el freno por ip cuenta a todos como uno solo
DETRAS_DE_PROXY=0

# --- base de datos mysql (valores por defecto de xampp) ---
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=root
BD_CLAVE=
BD_NOMBRE=ceipaj_sig

# --- institución (editable también desde la pantalla de configuración) ---
INSTITUCION_NOMBRE=CEIPAJ
INSTITUCION_CIUDAD=Luque

# --- seguridad ---
# poner una cadena larga y aleatoria: firma los tokens de sesión (jwt)
JWT_SECRETO=cambiar-por-una-clave-larga-y-aleatoria
# método 2fa por defecto para las cuentas nuevas: app | email | sms
METODO_2FA_DEFECTO=app
# en 0 apaga los atajos que muestran códigos y claves temporales en pantalla.
# en el servidor va 0 (una vez que el smtp real esté andando)
MODO_PRUEBA=1

# --- sms por twilio verify (2fa por sms; también se configura desde la pantalla) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_VERIFY_SID=
# prefijo que se antepone a los celulares cargados sin código de país
SMS_PREFIJO_PAIS=+595

# --- correo saliente (credenciales de aliados y usuarios nuevos) ---
# sin estos datos el sistema muestra la clave temporal en pantalla una sola vez
SMTP_HOST=
# 587 es el estándar; si la red lo bloquea, usar 465 (es el que quedó en el servidor)
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=CEIPAJ <no-responder@ceipaj.edu.py>

# --- pasarela de pagos ---
# proveedor: simulada | pagopar | adamspay. también se elige desde Configuración.
PASARELA_PROVEEDOR=simulada

# pagopar: tokens del comercio, del panel en "Integrar con mi sitio web".
# el token privado nunca viaja, solo firma los pedidos.
PAGOPAR_TOKEN_PUBLICO=
PAGOPAR_TOKEN_PRIVADO=

# adamspay: credenciales de la aplicación creada en el panel del comercio.
# entorno: staging (pruebas) | produccion
ADAMSPAY_ENTORNO=staging
ADAMSPAY_API_KEY=
ADAMSPAY_SECRETO=

# el checkout se muestra dentro de la pantalla; en 0 se abre en otra pestaña
CHECKOUT_INCRUSTADO=1

# cuántos segundos se recuerda el plan vigente de cada institución antes de
# volver a leerlo de la base. un cambio de plan se siente a más tardar en este tiempo
CACHE_PLAN_SEGUNDOS=20

# --- recibo de pago ---
# datos del emisor que salen impresos. también se cargan desde Configuración.
# no es una factura: el recibo de dinero no se timbra y lo dice impreso.
RECIBO_EMISOR_NOMBRE=
RECIBO_EMISOR_DIRECCION=
RECIBO_EMISOR_TELEFONO=
RECIBO_EMISOR_CORREO=
RECIBO_SERIE=REC

# --- captcha del ingreso (recaptcha v2) ---
# las claves salen gratis de google.com/recaptcha/admin, tipo casilla.
# también se cargan desde Configuración. sin las dos, el captcha no se exige.
RECAPTCHA_ACTIVO=0
RECAPTCHA_CLAVE_SITIO=
RECAPTCHA_CLAVE_SECRETA=

# --- sistema académico (conversión) ---
# el sistema NO sale a buscar datos: el académico los empuja a
# POST /api/conversion/matriculados con esta clave en la cabecera X-API-Key.
# también se pueden cargar a mano con una planilla csv.
ACADEMICO_CLAVE_ENTRADA=
# cada cuántos minutos sincronizar solo (0 = solo con el botón de la pantalla)
ACADEMICO_MINUTOS_SINCRONIZACION=0
